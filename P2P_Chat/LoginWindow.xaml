<Window x:Class="P2P_Chat.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:P2P_Chat"
        mc:Ignorable="d"
        Title="Logowanie" Height="150" Width="300" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock Text="Podaj swoją nazwę:" Margin="0,0,0,10"/>
        <TextBox x:Name="UsernameInput" Margin="0,0,0,10"/>
        <Button Content="Wejdź do czatu" Click="LoginButton_Click" IsDefault="True"/>
    </StackPanel>
</Window>
