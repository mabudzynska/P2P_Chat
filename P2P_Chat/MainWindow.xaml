<Window x:Class="P2P_Chat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="P2P Chat" Height="450" Width="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>

        <ListBox x:Name="ChatBox" Grid.Row="0" Grid.Column="0" Margin="0,0,10,10"/>

        <StackPanel Grid.Row="0" Grid.Column="1">

            <HeaderedContentControl Header="Użytkownicy">
                <ListBox x:Name="PeersListBox"
                 Height="150"
                 Margin="0,0,0,10"/>
            </HeaderedContentControl>

            <HeaderedContentControl Header="Grupy">
                <ListBox x:Name="GroupList"
                 Height="150"
                 Margin="0,0,0,10"
                 SelectionChanged="GroupList_SelectionChanged"
                 MouseDoubleClick="GroupList_DoubleClick"/>
            </HeaderedContentControl>

            <Button Content="Create Group"
            Height="30"
            Click="CreateGroup_Click"/>
        
        </StackPanel>
        
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
            <TextBox x:Name="MessageInput" Width="495" Margin="0,0,5,0"/>
            <Button Content="Wyślij" Click="SendButton_Click" Width="80"/>
        </StackPanel>
    </Grid>
</Window>